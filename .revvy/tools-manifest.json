    },
    "description": "List, revert, or apply the overrides a prefab instance carries relative to its source asset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Operation to perform.",
          "enum": [
            "list_overrides",
