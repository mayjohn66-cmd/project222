            "mouse_button_up"
          ],
          "type": "string"
        },
        "button": {
          "default": "",
          "description": "For mouse_button_down and mouse_button_up: which mouse button.",
          "enum": [
            "left",
            "right",
            "middle"
          ],
          "type": "string"
        },
        "key": {
          "default": "",
          "description": "For key_down and key_up: engine-neutral key name from the curated vocabulary.",
          "enum": [
            "a",
