        "action"
      ],
      "type": "object"
    },
    "name": "manage_properties"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyActions": [
        "list_overrides"
      ],
      "readOnlyHint": false,
