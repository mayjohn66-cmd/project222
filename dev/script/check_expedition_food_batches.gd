extends Node
var checks := 0
var failures := 0
const FISH := "fish_stream_minnow"
const RESULT = preload("res://script/expedition/services/expedition_result_service.gd")
func check(ok: bool, text: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error(text)
func frames() -> void:
	for i in range(10): await get_tree().process_frame
func reset(day: int = 1) -> void:
	GameState.initialize_new_game()
	PlayerProgress.reset()
	GameState.money = 1000
	GameState.inventory.clear()
	GameState.store_layout.clear()
	GameState.total_day = day
	GameState.preservation_state = PreservationService.initial_state(day)
func advance(days: int) -> void:
	GameState.total_day += days
	FoodShelfLife.settle()
func inventory_lots() -> Array: return FoodShelfLife.peek_inventory(FISH,999)
func waste() -> int: return int(FoodShelfLife.state()["waste"].get(FISH,0))
func mixed_bag() -> ExpeditionBag:
	GameState.add_item(FISH,3)
	advance(1)
	GameState.add_item(FISH,2)
	var lots := FoodShelfLife.take_inventory(FISH,4)
	var bag := ExpeditionBag.new()
	check(bag.add_item(FISH,Vector2i.ZERO,4,false,{"food_batches":lots}) > 0,"actual FIFO batch transfer into bag model")
	return bag
func snap(label: String) -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty() or DisplayServer.get_name() == "headless": return
	await get_tree().create_timer(0.4).timeout
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png(args[0]+"-"+label+".png")
func _ready() -> void: call_deferred("run")
func run() -> void:
	check(OS.get_user_data_dir().contains("foodbag_checks"),"isolated test user directory")
	if not OS.get_user_data_dir().contains("foodbag_checks"):
		get_tree().quit(1)
		return
	reset()
	var bag := mixed_bag()
	var lots: Array = bag.placements[0]["food_batches"]
	check(lots.size() == 2 and lots[0]["age"] == 2 and lots[0]["amount"] == 3 and lots[1]["age"] == 0,"different acquisition ages stay separate")
	check(GameState.get_item_count(FISH) == 1 and FoodShelfLife.quantity(lots) == 4,"move conserves all five items")
	var original := bag.placements.duplicate(true)
	var target := ExpeditionBag.new()
	check(not GridTransferHelper.move_or_transfer(bag,target,int(bag.placements[0]["uid"]),Vector2i(99,99))["success"] and bag.placements == original,"failed transfer keeps source lots and counts")
	var moved := GridTransferHelper.move_or_transfer(bag,target,int(bag.placements[0]["uid"]),Vector2i(1,0))
	check(moved["success"] and bag.placements.is_empty() and target.placements[0]["food_batches"] == lots,"grid transfer preserves exact lots once")
	check(target.move_item(int(target.placements[0]["uid"]),Vector2i(2,0)) and target.rotate_item(int(target.placements[0]["uid"])),"existing move and rotate still work")
	check(target.placements[0]["food_batches"] == lots,"move/rotation do not refresh food")
	var settled: Dictionary = RESULT.new().deposit_items(target)
	check(settled["success"] and settled["deposited_amount"] == 4,"real return settlement deposits food stock")
	var returned := inventory_lots()
	check(GameState.get_item_count(FISH) == 5 and returned.size() == 2 and returned[0]["age"] == 2 and returned[0]["amount"] == 3,"return merges original batches without resetting age")
	check(FoodShelfLife.receipt_total(FISH,returned) == 164,"same old-stock markdown after return")
	check(RESULT.new().deposit_items(target)["deposited_amount"] == 0 and GameState.get_item_count(FISH) == 5,"repeat settlement cannot duplicate food")
	advance(1)
	check(GameState.get_item_count(FISH) == 2 and waste() == 3,"original older lots expire on original day")
	check(inventory_lots()[0]["age"] == 2,"newer lot retains its later expiry")
	reset()
	bag = mixed_bag()
	GameState.save_expedition_bag(bag.placements)
	advance(1)
	check(GameState.saved_expedition_bag.size() == 1 and GameState.saved_expedition_bag[0]["amount"] == 1,"saved bag is ambient storage, not a freezer")
	check(waste() == 3 and GameState.get_item_count(FISH) == 1,"saved bag and inventory account their actual stock")
	FoodShelfLife.settle()
	check(waste() == 3,"same-day repeated query never repeats expiry")
	advance(1)
	check(GameState.saved_expedition_bag.is_empty() and GameState.get_item_count(FISH) == 0 and waste() == 5,"all saved and inventory food eventually expires once")
	reset()
	bag = mixed_bag()
	advance(1)
	settled = RESULT.new().deposit_items(bag)
	check(settled["success"] and settled["deposited_amount"] == 1 and GameState.get_item_count(FISH) == 2,"standalone old bag expires before depositing; only live lots return")
	check(waste() == 3 and bag.placements.is_empty(),"expired bag food goes to existing waste ledger once")
	reset()
	bag = mixed_bag()
	GameState.save_expedition_bag(bag.placements)
	GameState.set_expedition_checkpoint({"bag_placements":bag.placements.duplicate(true)})
	advance(1)
	check(waste() == 3 and GameState.saved_expedition_bag[0]["amount"] == 1 and GameState.expedition_checkpoint["bag_placements"][0]["amount"] == 1,"inactive checkpoint owns stock and saved mirror cannot double-count expiry")
	advance(1)
	check(waste() == 5 and GameState.saved_expedition_bag.is_empty() and GameState.expedition_checkpoint["bag_placements"].is_empty(),"checkpoint reload cannot resurrect expired mirror stock")
	reset(80)
	var legacy: Array[Dictionary] = [{"uid":10,"item_id":FISH,"amount":2,"cell":Vector2i.ZERO,"rotated":false}]
	bag = ExpeditionBag.new()
	check(bag.load_placements(legacy),"legacy bag without food field still loads")
	check(bag.placements[0]["food_batches"] == [{"amount":2,"age":0,"day":80}] and not legacy[0].has("food_batches"),"legacy adopts current day without altering caller's data")
	GameState.save_expedition_bag(legacy)
	FoodShelfLife.settle()
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["day"] == 80,"inactive legacy stock is adopted once")
	advance(1)
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["age"] == 2,"legacy baseline continues aging after adoption")
	reset()
	PlayerProgress.record_story_beat(OpeningJourneyFlow.PROLOGUE,1)
	bag = ExpeditionBag.new()
	bag.add_item(FISH,Vector2i.ZERO,1)
	GameState.save_expedition_bag(bag.placements)
	advance(20)
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["age"] == 0 and waste() == 0,"existing tutorial grace also protects bag food")
	for step in FoodShelfLife.SETTINGS.grace_steps: PlayerProgress.record_story_beat("tutorial_step:"+step+":done",GameState.total_day)
	FoodShelfLife.settle()
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["age"] == 0,"grace end never deducts past protected days")
	advance(1)
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["age"] == 2,"normal aging resumes after tutorial")
	reset()
	bag = mixed_bag()
	GameState.save_expedition_bag(bag.placements)
	var save := GameState.create_save_data()
	var path := "user://food_bag_roundtrip.dat"
	check(GameState.write_save_file(save,path),"binary saved-bag file write in isolated directory")
	var loaded := GameState.read_save_file(path)
	check(loaded == save and GameState.apply_save_data(loaded),"binary read/apply preserves all nested batch ints and dates")
	bag = ExpeditionBag.new()
	check(bag.load_placements(GameState.get_saved_expedition_bag()) and bag.placements[0]["food_batches"] == lots,"grid restore preserves old and new lots")
	var unchanged := bag.placements.duplicate(true)
	for bad_batches in [42,[],[{"amount":99,"age":2,"day":2}],[{"amount":4,"age":-1,"day":2}],[{"amount":4,"age":0,"day":3}],[{"amount":4,"age":0.5,"day":2}],[{"amount":4,"age":0,"day":0}],[{"amount":4,"age":0,"day":2.0}]]:
		var bad := save.duplicate(true)
		bad["saved_expedition_bag"][0]["food_batches"] = bad_batches
		check(not GameState.is_save_data_valid(bad),"bad saved food metadata rejected: "+str(bad_batches))
		var invalid: Array[Dictionary] = bag.placements.duplicate(true)
		invalid[0]["food_batches"] = bad_batches
		check(not bag.load_placements(invalid) and bag.placements == unchanged,"bad restore is atomic: "+str(bad_batches))
		check(bag.add_item(FISH,Vector2i(1,0),4,false,{"food_batches":bad_batches}) < 0 and bag.placements == unchanged,"bad new placement never becomes fresh fallback")
	var malformed := save.duplicate(true)
	malformed["expedition_checkpoint"] = {"bag_placements":unchanged.duplicate(true)}
	malformed["expedition_checkpoint"]["bag_placements"][0]["food_batches"] = 42
	check(not GameState.is_save_data_valid(malformed),"checkpoint batches use same save validation")
	var legacy_save := save.duplicate(true)
	legacy_save["saved_expedition_bag"][0].erase("food_batches")
	check(GameState.is_save_data_valid(legacy_save),"optional field keeps legacy full saves valid")
	reset()
	bag = mixed_bag()
	GameState.save_expedition_bag(bag.placements)
	var saved_lots: Array = bag.placements[0]["food_batches"].duplicate(true)
	var checkpoint_world = load("res://scenes/expedition/expedition.tscn").instantiate()
	add_child(checkpoint_world)
	await frames()
	check(checkpoint_world.expedition_checkpoint_controller.save("user://food_bag_checkpoint.dat"),"actual checkpoint controller writes isolated binary file")
	loaded = GameState.read_save_file("user://food_bag_checkpoint.dat")
	check(loaded["expedition_checkpoint"]["bag_placements"][0]["food_batches"] == saved_lots,"actual checkpoint contains original batches")
	checkpoint_world.queue_free()
	await frames()
	check(GameState.apply_save_data(loaded),"actual checkpoint file applies")
	checkpoint_world = load("res://scenes/expedition/expedition.tscn").instantiate()
	add_child(checkpoint_world)
	await frames()
	check(checkpoint_world.expedition_bag.placements[0]["food_batches"] == saved_lots,"actual scene auto-resumes batches without a new baseline")
	advance(1)
	await frames()
	check(checkpoint_world.expedition_bag.placements[0]["amount"] == 1 and waste() == 3,"resumed checkpoint expires old lot once across live bag and mirrors")
	checkpoint_world.queue_free()
	await frames()
	reset()
	for item in FoodShelfLife.rules():
		if not ItemData.can_store_in_expedition_bag(item): continue
		GameState.add_item(item,2)
		FoodShelfLife.state()["inventory"][item][0]["age"] = FoodShelfLife.SETTINGS.ambient_age
		var reference := FoodShelfLife.take_inventory(item,2)
		var every := ExpeditionBag.new()
		check(every.add_item(item,Vector2i.ZERO,2,false,{"food_batches":reference}) > 0,"all compatible foods pack with batches: "+item)
		settled = RESULT.new().deposit_items(every)
		check(settled["success"] and FoodShelfLife.peek_inventory(item,2) == reference,"all compatible foods return unchanged: "+item)
	reset()
	check(PreservationService.install("freezer"),"existing cold-storage setup")
	GameState.add_item(FISH,1)
	check(PreservationService.deposit("freezer",FISH,1) == 1,"actual freezer transfer")
	advance(10)
	check(PreservationService.withdraw("freezer",FISH,1) == 1,"actual thaw into inventory")
	var cold := FoodShelfLife.take_inventory(FISH,1)
	bag = ExpeditionBag.new()
	bag.add_item(FISH,Vector2i.ZERO,1,false,{"food_batches":cold})
	GameState.save_expedition_bag(bag.placements)
	advance(1)
	check(GameState.saved_expedition_bag[0]["food_batches"][0]["age"] == 2,"thawed stock resumes ambient aging in bag")
	advance(1)
	check(GameState.saved_expedition_bag.is_empty() and waste() == 1,"bag cannot keep former freezer stock frozen")
	reset()
	bag = mixed_bag()
	GameState.save_expedition_bag(bag.placements)
	var world = load("res://scenes/expedition/expedition.tscn").instantiate()
	add_child(world)
	await frames()
	check(world.is_in_group(ExpeditionFoodBatches.LIVE_GROUP),"actual expedition registers food ownership")
	bag = world.expedition_bag
	lots = bag.placements[0]["food_batches"].duplicate(true)
	var uid: int = int(bag.placements[0]["uid"])
	world.return_bag_item_to_loot({"uid":uid})
	await frames()
	check(bag.placements.is_empty() and world.temporary_loot.size() == 1 and world.temporary_loot[0]["food_batches"] == lots,"real bag-to-loot preserves exact batches")
	world.drop_grid_data("bag",{"source":"loot","loot_index":0,"grab_offset":Vector2i.ZERO},Vector2i.ZERO)
	await frames()
	check(world.temporary_loot.is_empty() and bag.placements[0]["food_batches"] == lots,"real loot-to-bag keeps expiry rather than new acquisition")
	var blocked: Dictionary = ExpeditionFoodBatches.loot(bag.placements[0])
	world.temporary_loot.append(blocked)
	var count := bag.placements.size()
	world.drop_grid_data("bag",{"source":"loot","loot_index":0,"grab_offset":Vector2i.ZERO},Vector2i.ZERO)
	check(world.temporary_loot.size() == 1 and bag.placements.size() == count,"occupied destination does not consume loose food")
	world.temporary_loot.clear() # test's deliberate duplicate fixture is not owned stock
	GameState.save_expedition_bag(bag.placements)
	GameState.set_expedition_checkpoint({"bag_placements":bag.placements.duplicate(true)})
	advance(1)
	await frames()
	check(bag.placements[0]["amount"] == 1 and bag.placements[0]["food_batches"][0]["age"] == 2,"live bag ages and removes only its expired lots")
	check(waste() == 3 and GameState.saved_expedition_bag[0]["amount"] == 1 and GameState.expedition_checkpoint["bag_placements"][0]["amount"] == 1,"live stock plus both mirrors reports waste once")
	FoodShelfLife.settle()
	check(waste() == 3,"live repeat queries cannot duplicate waste")
	world.temporary_loot.append({"item_id":FISH,"amount":1})
	world.refresh_loot_ui()
	check(world.temporary_loot[0]["food_batches"] == [{"amount":1,"age":0,"day":GameState.total_day}],"new loose drop receives acquisition baseline")
	var selected := int(bag.placements[0]["uid"])
	world.return_bag_item_to_loot({"uid":selected})
	await frames()
	advance(1)
	await frames()
	check(world.temporary_loot.size() == 1 and world.temporary_loot[0]["food_batches"][0]["age"] == 2 and waste() == 5,"loose original food expires, fresh drop survives; mirrors do not double waste")
	world.drop_grid_data("bag",{"source":"loot","loot_index":0,"grab_offset":Vector2i.ZERO},Vector2i.ZERO)
	world.result_info_label.text = world.expedition_result_service.build_result_text(bag,"월요일")
	world.set_expedition_phase(world.ExpeditionPhase.RESULT)
	await frames()
	var guide: ExpeditionReturnGuide = world.result_panel.get_node("ReturnGuide")
	guide.select(true)
	await frames()
	check(guide.note.text.contains("이전 식품 기한") and guide.note.text.contains("상온 보관"),"actual result help explains retained expiry")
	await snap("return")
	guide.select(false)
	settled = world.expedition_result_service.deposit_items(bag)
	check(settled["success"] and GameState.get_item_count(FISH) == 1 and inventory_lots()[0]["age"] == 2,"actual scene settlement preserves surviving food age")
	GameState.clear_expedition_checkpoint()
	GameState.save_expedition_bag(bag.placements)
	world.queue_free()
	await frames()
	advance(1)
	check(GameState.get_item_count(FISH) == 0 and waste() == 6,"returned food expires on next original due day")
	reset()
	bag = ExpeditionBag.new()
	bag.add_item("iron_ore",Vector2i.ZERO,2,false,{"blacksmith_ore_origin":true})
	bag.add_item("rusty_sword",Vector2i(1,0),1,false,{"instance_id":123,"enhancement_level":2})
	check(not bag.placements[0].has("food_batches") and not bag.placements[1].has("food_batches"),"nonfood does not gain food metadata")
	settled = RESULT.new().deposit_items(bag)
	check(settled["success"] and settled["deposited_amount"] == 2 and bag.placements.size() == 1 and bag.placements[0]["enhancement_level"] == 2,"ore settlement and retained equipment semantics unchanged")
	print("CHECK_EXPEDITION_FOOD_BATCHES checks=%d failures=%d" % [checks,failures])
	get_tree().quit(0 if failures == 0 else 1)
