extends Node
var checks := 0
var failures := 0
var world
var builder
var menu
var player
var construction
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error(message)
func frames() -> void:
	for i in range(8): await get_tree().process_frame
func snap(name: String) -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty() or DisplayServer.get_name() == "headless": return
	await get_tree().create_timer(2.0,true,false,true).timeout
	await frames()
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png(args[0] + "-" + name + ".png")
	check(menu.current_tab == ManagementMenu.MenuTab.CONSTRUCTION,"captured page is actual construction guidance")
	for label in [construction.current_info_label,construction.next_info_label,construction.note_label]:
		check(label.is_visible_in_tree(),"captured guide label is visible: " + label.name)
		check(label.get_global_rect().end.y <= construction.get_global_rect().end.y + 1,"actual guide label remains inside book: " + label.name)
	if construction.expand_button.visible: check(construction.expand_button.get_global_rect().end.y <= construction.get_global_rect().end.y + 1,"navigation button remains readable inside book")
func click(button: Button) -> void:
	await get_tree().create_timer(1.7,true,false,true).timeout
	var position := button.get_global_rect().get_center()
	if menu.has_meta("book_stage") and is_instance_valid(menu.get_meta("book_stage")):
		position += menu.get_meta("book_stage")._offset
	for pressed in [true,false]:
		var event := InputEventMouseButton.new()
		event.position = position
		event.button_index = MOUSE_BUTTON_LEFT
		event.pressed = pressed
		get_viewport().push_input(event,true)
	await frames()
func place(id: String) -> Node2D:
	if not builder.build_mode: builder.start_build_mode()
	builder.build_selection_state.restore_selection(builder.get_catalog_index_from_build_id(id),0)
	builder.create_preview()
	for x in range(builder.floor.columns):
		for y in range(builder.floor.rows):
			var cell := Vector2i(x,y)
			if builder.can_place(cell): return builder.build_placement_service.place_furniture(id,cell)
	return null
func view() -> Dictionary:
	menu.open_menu(ManagementMenu.MenuTab.CONSTRUCTION)
	menu.select_tab(ManagementMenu.MenuTab.CONSTRUCTION)
	construction.refresh_view()
	return RoomPreparationGuide.next_action(construction)
func fixture_machine(parent: Node, preview := false) -> Node:
	var node = BuildObjectData.get_build_scene("magic_oven").instantiate()
	node.set_meta("build_id","magic_oven")
	node.set_meta("is_build_preview",preview)
	parent.add_child(node)
	return node
func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	call_deferred("run")
func run() -> void:
	GameState.initialize_new_game()
	PlayerProgress.reset()
	world = load("res://scenes/shop/main.tscn").instantiate()
	world.get_node("TutorialDirector").enabled = false
	get_tree().root.add_child(world)
	get_tree().current_scene = world
	await frames()
	OpeningJourneyFlow.initialize(world)
	builder = world.get_node("BuildManager")
	player = world.get_node("Actors/Player")
	player.set_physics_process(false)
	var manager = world.get_node("DayManager")
	manager.hour_timer.stop()
	manager.customer_spawner.set_process(false)
	menu = manager.management_menu
	construction = menu.construction_content
	menu.space_menu.refresh()
	check(RoomPreparationGuide.next_action(self).is_empty(),"guide without main world is harmless")
	check(view().is_empty() and not construction.next_info_label.text.contains("5000"),"early store keeps existing preparation without future costs")
	for step in TutorialDirector.SETTINGS.steps:
		if not step.get("optional",false): PlayerProgress.record_story_beat("tutorial_step:" + str(step["id"]) + ":done",1)
	PlayerProgress.record_story_beat(ResidentRequestFlow.PREFIX + "settle_naru:done",1)
	var tutorial = world.get_node("TutorialDirector")
	tutorial.flow.introduce(TutorialDirector.SETTINGS.steps[-1])
	check(view().is_empty() and construction.expand_button.text == "생산실 문 배치","door preparation retains actual existing build action")
	menu.close_menu()
	var door := place("production_door")
	check(door != null,"actual door constructs production room")
	builder.confirm_build_changes()
	var data := view()
	check(data["next"].contains("생산실에 들어가기") and not construction.expand_button.visible,"room built without entry first asks for onsite entry")
	await snap("enter-production")
	menu.close_menu()
	player.global_position = door.global_position
	check(player.try_use_production_door() and player.in_production_room,"real E entry is recorded")
	data = view()
	check(data["action"] == "inventory" and data["next"].contains("화덕 설치"),"owned first oven is installed rather than purchased again")
	var quantity := GameState.get_furniture_count("magic_oven")
	construction.expand_button.pressed.emit()
	check(menu.current_tab == ManagementMenu.MenuTab.INVENTORY and GameState.get_furniture_count("magic_oven") == quantity and not builder.build_mode,"actual navigation opens furniture inventory without auto placement or charge")
	view()
	GameState.remove_furniture("magic_oven",quantity)
	construction.expand_button.pressed.emit()
	check(menu.current_tab == ManagementMenu.MenuTab.BLUEPRINT and menu.blueprint_content.selected_furniture_id == "magic_oven","button rechecks missing furniture instead of following stale inventory action")
	data = view()
	check(data["action"] == "blueprint","missing first oven routes to actual crafting information")
	construction.expand_button.pressed.emit()
	check(menu.current_tab == ManagementMenu.MenuTab.BLUEPRINT and menu.blueprint_content.selected_furniture_id == "magic_oven" and GameState.get_furniture_count("magic_oven") == 0,"blueprint navigation selects correct recipe without crafting")
	GameState.add_furniture("magic_oven",quantity)
	var preview := fixture_machine(world.get_node("ProductionRoom/Objects"),true)
	var wrong_room := fixture_machine(world.get_node("Objects"))
	await frames()
	check(view()["action"] == "inventory","preview and wrong-room machines cannot satisfy real first installation")
	preview.queue_free()
	wrong_room.queue_free()
	await frames()
	menu.close_menu()
	var oven = place("magic_oven")
	check(oven != null,"real oven placed through original builder")
	builder.confirm_build_changes()
	var learned := PlayerProgress.learned_recipe_ids.duplicate()
	PlayerProgress.learned_recipe_ids.erase("camp_bread")
	data = view()
	check(data["action"] == "scroll" and data["next"].contains("배우기"),"received first scroll leads to learning it instead of asking the NPC again")
	var scroll_id := str(data["id"])
	var scroll_count := GameState.get_item_count(scroll_id)
	var learning_money := GameState.money
	await snap("learn-scroll")
	await click(construction.expand_button)
	check(menu.current_tab == ManagementMenu.MenuTab.INVENTORY and menu.management_inventory.selected_inventory_group == ItemData.get_inventory_group(scroll_id),"real construction link opens scroll's actual inventory category")
	var learning_inventory = menu.management_inventory
	learning_inventory._on_recipe_scroll_selected(scroll_id)
	check(not PlayerProgress.is_recipe_learned("camp_bread") and GameState.get_item_count(scroll_id) == scroll_count,"opening learning confirmation does not consume or teach")
	learning_inventory.recipe_scroll_dialog.confirmed.emit()
	learning_inventory.recipe_scroll_dialog.hide()
	check(PlayerProgress.is_recipe_learned("camp_bread") and GameState.get_item_count(scroll_id) == scroll_count - 1 and GameState.money == learning_money,"actual learning confirmation consumes exactly one granted scroll without extra cost")
	learning_inventory.recipe_scroll_dialog.confirmed.emit()
	check(GameState.get_item_count(scroll_id) == scroll_count - 1,"repeated confirmation cannot consume another scroll")
	PlayerProgress.learned_recipe_ids.erase("camp_bread")
	var remaining_scrolls := GameState.get_item_count(scroll_id)
	GameState.remove_item(scroll_id,remaining_scrolls)
	data = view()
	check(data["action"] == "learned" and not data["next"].contains("버섯"),"missing first recipe without owned scroll retains original source fallback")
	GameState.add_item(scroll_id,remaining_scrolls)
	PlayerProgress.learned_recipe_ids.assign(learned)
	PlayerProgress.learn_recipe("camp_bread")
	var ingredients := ProductionRecipeService.collect_required_ingredients(ProductRecipeData.get_recipe("camp_bread"),1)
	for id in ingredients: GameState.inventory.erase(id)
	data = view()
	check(data["next"].contains("재료 준비") and data["next"].contains("부족") and data["note"].contains("꺼내"),"actual first recipe shortage and required withdrawal explained")
	await snap("ingredients")
	construction.expand_button.pressed.emit()
	check(menu.current_tab == ManagementMenu.MenuTab.PRODUCTION and menu.management_production.preparation_book.mode == "today","preparation navigation opens today's learned products")
	for id in ingredients: GameState.add_item(id,int(ingredients[id]))
	check(view()["next"].contains("첫 상품 만들기"),"actual carried ingredients change next action to onsite production")
	var inventory := GameState.inventory.duplicate(true)
	var progress := PlayerProgress.to_save_data().duplicate(true)
	var money := GameState.money
	var machine_save: Dictionary = oven.get_production_save_data().duplicate(true)
	for i in range(5): RoomPreparationGuide.next_action(construction)
	check(GameState.inventory == inventory and PlayerProgress.to_save_data() == progress and GameState.money == money and oven.get_production_save_data() == machine_save,"repeated guide reads do not spend, start, learn, collect or advance")
	menu.close_menu()
	check(oven.start_production("camp_bread",1),"original onsite production consumes real recipe ingredients")
	data = view()
	check(data["action"] == "facilities" and data["next"].contains("가공 중") and data["note"].contains("멈춥니다"),"busy oven prompts closing paused book before waiting")
	construction.expand_button.pressed.emit()
	check(menu.management_production.preparation_book.mode == "facilities" and not ShopSpaceProgression.first_product(),"real facilities link cannot count as first product")
	var second := fixture_machine(world.get_node("ProductionRoom/Objects"))
	for id in ingredients: GameState.add_item(id,int(ingredients[id]))
	check(view()["next"].contains("첫 상품 만들기"),"an idle second oven with ingredients remains usable while another is processing")
	second.queue_free()
	await frames()
	for id in ingredients: GameState.remove_item(id,int(ingredients[id]))
	var processing: Dictionary = oven.get_production_save_data().duplicate(true)
	oven.apply_production_save_data(processing)
	check(view()["next"].contains("가공 중"),"restored processing state shows correct next action")
	oven._process(oven.remaining_seconds + 1)
	data = view()
	check(data["next"].contains("완성품 수령") and data["next"].contains(str(oven.pending_amount)) and not ShopSpaceProgression.first_product(),"real completed batch is distinguished from collection")
	await snap("collect")
	tutorial.enabled = true
	tutorial.set_process(false)
	oven.output_collected.connect(tutorial._on_output_collected)
	menu.close_menu()
	check(oven.collect_production() and ShopSpaceProgression.first_product(),"actual first bread collection alone advances warehouse stage")
	check(view().is_empty() and construction.expand_button.text == "창고 문 배치","first receipt returns existing next door action")
	menu.close_menu()
	player.global_position = world.get_node("ProductionRoom").get_entry_world_position()
	player.try_use_production_door()
	var warehouse_door := place("warehouse_door")
	check(warehouse_door != null,"actual warehouse door placed")
	builder.confirm_build_changes()
	check(view()["next"].contains("창고에 들어가기"),"new warehouse first asks for real entry")
	menu.close_menu()
	player.global_position = warehouse_door.global_position
	check(player.try_use_warehouse_door() and player.in_warehouse_room,"real warehouse entry recorded")
	var legacy_count := GameState.get_furniture_count("warehouse_rack")
	GameState.remove_furniture("warehouse_rack",legacy_count)
	data = view()
	check(data["action"] == "blueprint" and data["id"] == "wood_warehouse_rack","no owned shelf selects currently craftable wood rather than obsolete no-recipe rack")
	construction.expand_button.pressed.emit()
	check(menu.blueprint_content.selected_furniture_id == "wood_warehouse_rack","actual warehouse blueprint navigation selects correct shelf")
	GameState.add_furniture("warehouse_rack",legacy_count)
	check(view()["id"] == "warehouse_rack" and view()["action"] == "inventory","existing owned legacy rack remains usable")
	var storage_preview = BuildObjectData.get_build_scene("warehouse_rack").instantiate()
	storage_preview.set_meta("build_id","warehouse_rack")
	storage_preview.set_meta("is_build_preview",true)
	world.get_node("WarehouseRoom/Objects").add_child(storage_preview)
	var other_storage = BuildObjectData.get_build_scene("warehouse_rack").instantiate()
	other_storage.set_meta("build_id","warehouse_rack")
	world.get_node("ProductionRoom/Objects").add_child(other_storage)
	await frames()
	check(view()["action"] == "inventory" and view()["current"].contains("설치 선반: 0개"),"warehouse preview and other-room stock do not satisfy first installation")
	storage_preview.queue_free()
	other_storage.queue_free()
	await frames()
	menu.close_menu()
	var rack = place("warehouse_rack")
	check(rack != null,"original rack installed in actual warehouse")
	builder.confirm_build_changes()
	GameState.inventory.clear()
	check(view()["next"].contains("보관할 물품 준비"),"empty carried inventory is handled without free item grant")
	GameState.add_item("wheat",1)
	check(view()["next"].contains("남은 물품 입고") and not ShopSpaceProgression.expansion_ready(),"shelf installation and reading do not complete deposit")
	var storage_save := {"wheat":rack.storage_capacity}
	check(rack.apply_stored_items(storage_save),"existing full storage fixture restores actual rack content")
	data = view()
	check(data["next"].contains("자리 마련") and data["current"].contains(str(rack.storage_capacity)) and not ShopSpaceProgression.expansion_ready(),"full shelf requires withdrawing before new real deposit")
	await snap("full-warehouse")
	var state := PlayerProgress.to_save_data().duplicate(true)
	var stock: Dictionary = rack.stored_items.duplicate(true)
	for i in range(5): RoomPreparationGuide.next_action(construction)
	check(rack.stored_items == stock and PlayerProgress.to_save_data() == state,"warehouse guidance does not expire stock or record a deposit")
	PlayerProgress.load_save_data(state)
	check(view()["next"].contains("자리 마련"),"existing saved milestones restore same guidance without new save field")
	menu.close_menu()
	check(rack.withdraw_slot_to_inventory(rack.find_item_slot("wheat"),1) == 1 and not ShopSpaceProgression.expansion_ready(),"actual withdrawal creates room without recording first deposit")
	check(view()["next"].contains("남은 물품 입고"),"live storage space updates instruction on reopening")
	await snap("deposit")
	menu.close_menu()
	check(rack.deposit_from_inventory("wheat",1) == 1 and ShopSpaceProgression.expansion_ready(),"real nonzero onsite deposit unlocks expansion normally")
	check(view().is_empty() and construction.next_info_label.text.contains(str(GameState.get_store_expansion_cost())),"after use original expansion cost and controls return")
	PlayerProgress.story_beat_days.erase(ShopSpaceProgression.VERSION)
	check(RoomPreparationGuide.next_action(construction).is_empty(),"older unrestricted saves receive no new first-use gating")
	get_tree().paused = false
	print("CHECK_ROOM_PREPARATION ",checks," checks / ",failures," failures")
	get_tree().quit(1 if failures else 0)
