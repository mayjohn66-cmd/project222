[gd_resource type="Resource" script_class="StoreEventStorySettings" load_steps=2 format=3]
[ext_resource type="Script" path="res://script/world/shop/events/store_event_story_settings.gd" id="1"]
[resource]
script = ExtResource("1")
moments = Array[Dictionary]([
{"id":"store_raid_rumor","event_id":"dungeon_raid","stage":"rumor","cue_items":["potion"],"cue_materials":["forest_herb","amber_sap","raw_water"],"context":"공용 행사로 계절과 관계없이 반복. 모험가들이 던전에 갈 채비. 포션 실제 추가 수요. 제조법을 아는 경우 약초·수액·채집한 물로 제작 가능. 미학습 제조법 해금 약속 없음."},
{"id":"store_raid_ongoing","event_id":"dungeon_raid","stage":"ongoing","context":"공용 행사로 계절과 관계없이 반복. 던전 공략 채비 기간. 포션을 찾는 모험가와 여행자가 실제로 늘어남. 판매 보장 없음."},
{"id":"store_raid_closing","event_id":"dungeon_raid","stage":"closing","context":"공용 행사로 계절과 관계없이 반복. 공략 채비 마지막 날. 마지막 준비 중이라는 서술. 모든 손님 퇴장·새 장면 약속 없음."},
{"id":"store_raid_finished","event_id":"dungeon_raid","stage":"finished","context":"공용 행사로 계절과 관계없이 반복. 포션 추가 수요 종료. 당시 실제 영업 기록만 함께 조회. 성공·매출을 추정하지 않음."},
{"id":"store_raid_bought","event_id":"dungeon_raid","stage":"bought","context":"공용 행사로 계절과 관계없이 반복. 이 행사 수요로 포션 실제 결제 완료한 손님에게만 자동 표시. 배경 손님의 스쳐 들리는 짧은 말."},
{"id":"store_raid_missing","event_id":"dungeon_raid","stage":"missing","context":"공용 행사로 계절과 관계없이 반복. 이 행사 수요로 포션을 찾지만 진열대에 재고가 전혀 없을 때만 표시. 손님을 벌주거나 강제 재고 충당 없음."},
{"id":"store_market_rumor","event_id":"spring_market","stage":"rumor","cue_items":["bread","berry_juice"],"cue_materials":["wheat","wild_berry","raw_water"],"context":"계절 행사로 매년 봄 반복. 봄 장터 매년 봄 해당 기간에 빵·열매 주스만 추가 수요. 밀로 빵, 야생 열매·채집한 물로 열매 주스 제조 가능. 별도의 마을 첫 장터 부탁과는 독립 매장 행사."},
{"id":"store_market_ongoing","event_id":"spring_market","stage":"ongoing","context":"계절 행사로 매년 봄 반복. 봄 장터 기간. 주민과 어린이 방문 비중·음식 구매 수량이 늘어남. 전 품목 판매 보장 없음."},
{"id":"store_market_closing","event_id":"spring_market","stage":"closing","context":"계절 행사로 매년 봄 반복. 봄 장터 마지막 날. 수요가 끝나는 것을 은근히 알림. 실제 장터 오브젝트·군중 생성 약속 없음."},
{"id":"store_market_finished","event_id":"spring_market","stage":"finished","context":"계절 행사로 매년 봄 반복. 봄 장터 추가 수요가 끝난 뒤 기억. 실제 판매 결과를 보기 전 잘 팔렸다고 쓰지 않음."},
{"id":"store_market_bought","event_id":"spring_market","stage":"bought","context":"계절 행사로 매년 봄 반복. 행사 빵·열매 주스 수요로 실제 결제한 손님의 짧은 반응. {item}은 실제 구매 상품 이름으로 치환하므로 이 토큰 유지."},
{"id":"store_market_missing","event_id":"spring_market","stage":"missing","context":"계절 행사로 매년 봄 반복. 행사 빵·열매 주스 수요를 선택했지만 진열대 재고가 없을 때. {item}은 실제 찾던 상품 이름이므로 토큰 유지."},
{"id":"store_trail_rumor","event_id":"trail_supplies","stage":"rumor","cue_items":["bread","water"],"cue_materials":["wheat","raw_water"],"context":"공용 행사로 계절과 관계없이 반복. 여행자들의 출발 준비. 실제 추가 수요는 빵과 물. 밀·채집한 물이 제조 재료. 새로운 길/원정/보상 해금 없음."},
{"id":"store_trail_ongoing","event_id":"trail_supplies","stage":"ongoing","context":"공용 행사로 계절과 관계없이 반복. 출발 준비 기간. 여행자 비중·빵과 물 구매 수요 실제 증가. 모든 손님 구매 보장 없음."},
{"id":"store_trail_closing","event_id":"trail_supplies","stage":"closing","context":"공용 행사로 계절과 관계없이 반복. 출발 준비 마지막 날. 짐을 마저 챙기는 분위기. 실제 일괄 퇴장 연출은 없음."},
{"id":"store_trail_finished","event_id":"trail_supplies","stage":"finished","context":"공용 행사로 계절과 관계없이 반복. 여행 준비 추가 수요 종료. 평소 판매는 계속됨. 매출 결과를 대사에서 추정하지 않음."},
{"id":"store_trail_bought","event_id":"trail_supplies","stage":"bought","context":"공용 행사로 계절과 관계없이 반복. 행사 수요로 빵 또는 물을 실제 결제한 여행자. {item}은 실제 구매 상품 이름으로 치환. 짧은 지나가는 말."},
{"id":"store_trail_missing","event_id":"trail_supplies","stage":"missing","context":"공용 행사로 계절과 관계없이 반복. 행사 수요의 빵 또는 물이 진열대에 전혀 없을 때. {item}은 실제 찾던 상품 이름. 가게를 비난하지 않음."},
{"id":"store_summer_rumor","event_id":"summer_cool_break","stage":"rumor","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음.","cue_items":["water","berry_juice"],"cue_materials":["raw_water","wild_berry"]},
{"id":"store_summer_ongoing","event_id":"summer_cool_break","stage":"ongoing","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음."},
{"id":"store_summer_closing","event_id":"summer_cool_break","stage":"closing","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음."},
{"id":"store_summer_finished","event_id":"summer_cool_break","stage":"finished","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음. 실제 결과를 대사에서 추측하지 않음. 그 회차의 영업 기록 조회."},
{"id":"store_summer_bought","event_id":"summer_cool_break","stage":"bought","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음. 실제 행사 수요가 선택된 결제/진열대 무재고일 때만 스쳐 들리는 말. {item}은 실제 상품 이름 치환이므로 유지."},
{"id":"store_summer_missing","event_id":"summer_cool_break","stage":"missing","context":"매년 여름 해당 기간에 물·열매 주스 추가 수요. 제조법을 아는 경우 채집한 물·야생 열매로 제작. 실제 그늘 오브젝트·냉장/갈증 시스템·회복 없음. 실제 행사 수요가 선택된 결제/진열대 무재고일 때만 스쳐 들리는 말. {item}은 실제 상품 이름 치환이므로 유지."},
{"id":"store_autumn_rumor","event_id":"autumn_shared_table","stage":"rumor","context":"매년 가을 해당 기간에 빵·버섯 스튜 추가 수요. 제조법을 아는 경우 밀·숲 버섯·마른 가지로 제작. 새 식탁·군중·먹기/회복 기능 없음.","cue_items":["bread","mushroom_stew"],"cue_materials":["wheat","forest_mushroom","dry_branch"]},
{"id":"store_autumn_ongoing","event_id":"autumn_shared_table","stage":"ongoing","context":"매년 가을 해당 기간에 빵·버섯 스튜 추가 수요. 제조법을 아는 경우 밀·숲 버섯·마른 가지로 제작. 새 식탁·군중·먹기/회복 기능 없음."},
