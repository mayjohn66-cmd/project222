[gd_resource type="Resource" script_class="ResidentRequestSettings" load_steps=2 format=3]

[ext_resource type="Script" path="res://script/world/shop/requests/resident_request_settings.gd" id="1"]

[resource]
script = ExtResource("1")
requests = Array[Dictionary]([
{"id":"neighbor_bread", "npc":"이웃 주민", "title":"이웃의 아침 식사", "item":"bread", "amount":2, "reputation":1, "money":30, "lines":["가게 운영에 익숙해졌구나! 우리 집 아침 식사로 빵 두 개를 부탁해도 될까?", "창고에 빵 두 개를 준비한 뒤 다시 말을 걸어 줘. 준비된 물건은 내게 전달돼.", "부탁을 들어주면 마을에 가게 이야기를 전하고 작은 사례도 할게."], "completion":["아침 식사를 챙겨 줘서 고마워! 가게 이야기를 이웃들에게 전할게."]},
{"id":"traveler_water", "npc":"마을 여행자", "title":"여행길에 필요한 물", "item":"water", "amount":2, "reputation":1, "money":30, "lines":["먼 길을 떠나기 전에 물 두 병이 필요해.", "물 두 병을 창고에 준비해서 가져다줘. 행상인 친구에게도 이 가게를 소개할게."], "completion":["이제 여행 준비가 끝났어. 친구도 이 가게를 찾아올 거야!"]},
{"id":"gatherer_herbs", "npc":"마을 채집가", "title":"숲의 약초 부탁", "item":"forest_herb", "amount":3, "reputation":1, "money":40, "lines":["마을에 쓸 약초가 조금 부족해. 숲의 약초 세 개를 부탁할게.", "원정에서 구한 재료는 창고로 옮겨 준비해 줘. 준비되면 다시 말해 줘."], "completion":["약초가 꼭 필요했는데 잘 가져왔네. 고마워!"]},
{"id":"miner_ore", "npc":"마을 광부", "title":"광부의 도구 수리", "item":"iron_ore", "amount":3, "reputation":1, "money":40, "lines":["도구를 수리할 철광석 세 개가 필요해.", "철광석을 창고에 준비해 줘. 보석을 찾는 동료에게도 가게를 알려 줄게."], "completion":["덕분에 일을 계속할 수 있겠어. 보석 채굴꾼 동료도 찾아올 거야."]},
{"id":"child_berries", "npc":"이웃 주민", "title":"마을 아이들의 간식", "item":"wild_berry", "amount":3, "reputation":1, "money":50, "lines":["아이들에게 나눠 줄 야생 열매 세 개를 구해 줄래?", "숲에서 찾거나 보관한 열매를 창고에 준비해 줘."], "completion":["아이들이 좋아하겠네. 가게가 마을에 많은 도움이 되고 있어!"]},
{"id":"healer_moss", "npc":"늪 치료사", "title":"치료사의 재료 준비", "item":"swamp_moss", "amount":3, "reputation":1, "money":60, "lines":["치료 재료로 쓸 늪 이끼 세 개가 필요해.", "늪에서 구한 이끼를 창고에 준비해 줘. 유물을 찾는 지인에게도 이 가게를 소개할게."], "completion":["주민들의 부탁을 꾸준히 들어줘서 고마워. 유물 사냥꾼도 이곳을 찾아올 거야."]}
])
customer_milestones = Array[Dictionary]([
{"completed":2, "type":"peddler"},
{"completed":4, "type":"gem_hunter"},
{"completed":6, "type":"relic_hunter"}
])
