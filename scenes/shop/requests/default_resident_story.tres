[gd_resource type="Resource" script_class="ResidentStorySettings" load_steps=2 format=3]
[ext_resource type="Script" path="res://script/world/shop/requests/resident_story_settings.gd" id="1"]

[resource]
script = ExtResource("1")
introductions = Array[Dictionary]([
{"type":"peddler", "npc":"행상인 나루", "lines":["안녕, 나는 물건을 싣고 여행하는 나루야. 이웃이 여기서 쉬어 가도 된다고 알려 줬어.", "텅 빈 길에서 가게 불빛을 보니 마음이 놓이네. 물 한 병을 마시며 잠깐 쉬어 가고 싶어.", "가끔 여기 머물러도 될까? 자리를 마련할 때 네게 작은 부탁을 해도 좋겠지?"]},
{"type":"gem_hunter", "npc":"채굴꾼 도윤", "lines":["나루에게 가게 이야기를 듣고 왔어. 나는 돌 속에서 반짝이는 것을 찾는 도윤이야.", "늘 떠돌았는데, 돌아와 쉴 곳이 있으면 좋겠다는 생각이 들어.", "이 가게 가까이에 작은 집을 지으면 어때? 하루하루 천천히 준비해 보자."]},
{"type":"relic_hunter", "npc":"여행자 소라", "lines":["나는 오래된 이야기를 찾아다니는 소라야. 길 끝에 사람들이 모인다는 소문을 듣고 왔어.", "처음에는 황무지였다고? 이제는 누군가 돌아오고 싶어 하는 곳이 됐네.", "함께 물을 나누고 이야기를 나눌 자리가 있으면 좋겠어. 서두르지는 않아도 돼."]}
])
settlement_requests = Array[Dictionary]([
{"id":"settle_naru", "requires_intro":"peddler", "npc":"행상인 나루", "title":"나루가 머무는 작은 노점", "item":"dry_branch", "amount":4, "reputation":1, "money":40, "lines":["잠깐 들렀다가 가는 길이 점점 아쉬워져. 이곳에 작은 노점을 놓고 쉬어 가려 해.", "마른 가지 네 개를 준비해 줄래? 내 짐에서 천을 꺼내 작은 지붕을 만들어 볼게.", "편할 때 가져다줘. 기한은 없어. 가게 일을 먼저 해도 괜찮아."], "completion":["지붕을 받칠 나무가 준비됐네. 함께 만든 작은 노점에서 여행자들을 맞이할게.", "이 길에 나도 머물 곳이 생겼어. 고마워. 다음에 오면 차 한 잔 나누자."]},
{"id":"settle_doyun", "requires_intro":"gem_hunter", "after":"settle_naru", "npc":"채굴꾼 도윤", "title":"도윤의 첫 집", "item":"iron_ore", "amount":4, "reputation":1, "money":50, "lines":["나루가 머무는 모습을 보니 나도 돌아올 곳을 만들고 싶어졌어.", "작은 집에 쓸 철광석 네 개를 부탁할게. 나무와 돌은 내가 조금씩 모아 둘게.", "튼튼한 문고리 하나부터 시작하면 돼. 작은 집이어도 쉬어 갈 수 있으면 충분해."], "completion":["덕분에 내 첫 집을 마무리할 수 있겠어. 이제 일을 마치면 이곳으로 돌아올 거야.", "가게 불빛을 보며 집으로 돌아온다는 게 참 좋네."]},
{"id":"settle_sora", "requires_intro":"relic_hunter", "after":"settle_doyun", "npc":"여행자 소라", "title":"함께 쓰는 우물", "item":"stone_shard", "amount":4, "reputation":1, "money":60, "lines":["머무는 사람이 늘었으니 함께 물을 길을 자리가 있으면 좋겠어.", "우물 가장자리를 다듬을 돌 조각 네 개를 부탁할게. 다른 사람들도 조금씩 도와준대.", "물이 모이듯 이야기도 모이겠지. 준비되면 언제든 말해 줘."], "completion":["이제 누구든 물을 마시고 쉬어 갈 수 있어. 함께 만든 우물이야.", "아직 작은 곳이지만, 나는 여기를 마을이라고 부르고 싶어."]}
])
managed_groups = PackedStringArray("NearbyHouses", "VillageExtraHouses", "VillageBlacksmith", "VillageToolShop", "VillageBuildings", "VillageDecor", "VillageGathering")
landmarks = Array[Dictionary]([
{"request":"settle_naru", "path":"VillageDecor/MarketStall", "title":"작은 노점"},
{"request":"settle_doyun", "path":"VillageExtraHouses/EastCottage", "title":"첫 집"},
{"request":"settle_sora", "path":"VillageDecor/VillageWell", "additional_paths":["VillageGathering/WellBench"], "title":"공동 우물"}
])
