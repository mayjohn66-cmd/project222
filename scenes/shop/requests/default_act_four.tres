moments = Array[Dictionary]([
{"id":"act4_a1_intro","npc":"타블렌","stage":"4막 A, 사건 a1_road_sign, 단계 1/3. 게시판에서 맡은 뒤 소개 완독. 수락과 소개만으로 물품 소비·보상 없음. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a1_delivery","npc":"코르빈","stage":"4막 A, 사건 a1_road_sign, 단계 2/3. 소개 후 보통 창고의 지정 물품을 준비. 전달 장면 완독 때만 소비. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a1_finish","npc":"타블렌","stage":"4막 A, 사건 a1_road_sign, 단계 3/3. 앞선 단계 완독 다음 날 이후. 이 최종 완독에서만 완료/이정표/단서 기록. A 경제 보상은 Claude의 설정값만, B는 별도 경제 보상 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a1_road_sign_title","npc":"플레이어 UI","stage":"게시판 제목/요약. 대사가 아님. 수량과 보상은 설정에 따름."},
{"id":"act4_a2_intro","npc":"먼 곳의 상단","stage":"4막 A, 사건 a2_far_caravan, 단계 1/3. 게시판에서 맡은 뒤 소개 완독. 수락과 소개만으로 물품 소비·보상 없음. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a2_sale","npc":"먼 곳의 상단","stage":"4막 A, 사건 a2_far_caravan, 단계 2/3. 먼 곳 상단의 지정 품목 실결제 기록 필요. 소개나 진열만으로 완료하지 않음. 물품은 정상 판매이며 별도 자동 소비 없음. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a2_finish","npc":"먼 곳의 상단","stage":"4막 A, 사건 a2_far_caravan, 단계 3/3. 앞선 단계 완독 다음 날 이후. 이 최종 완독에서만 완료/이정표/단서 기록. A 경제 보상은 Claude의 설정값만, B는 별도 경제 보상 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a2_far_caravan_title","npc":"플레이어 UI","stage":"게시판 제목/요약. 대사가 아님. 수량과 보상은 설정에 따름."},
{"id":"act4_a3_intro","npc":"쉬어 가는 길손","stage":"4막 A, 사건 a3_traveler_rest, 단계 1/3. 게시판에서 맡은 뒤 소개 완독. 수락과 소개만으로 물품 소비·보상 없음. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a3_delivery","npc":"코르빈","stage":"4막 A, 사건 a3_traveler_rest, 단계 2/3. 소개 후 보통 창고의 지정 물품을 준비. 전달 장면 완독 때만 소비. 소개 후 실제 제작한 나무 보관 선반을 가구 창고에서 전달, 완독 때 소비. 지붕·침상 추가나 숙박 수입은 구현하지 않았으므로 약속 금지. 중간 단계에는 추가 돈·물품·평판 답례 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
{"id":"act4_a3_finish","npc":"쉬어 가는 길손","stage":"4막 A, 사건 a3_traveler_rest, 단계 3/3. 앞선 단계 완독 다음 날 이후. 이 최종 완독에서만 완료/이정표/단서 기록. A 경제 보상은 Claude의 설정값만, B는 별도 경제 보상 없음. 부분 읽기·취소·장면 이탈은 진행하지 않음. 수량·금액·날짜·키는 UI. 새 고유 이름과 전이 원인 단정 금지."},
