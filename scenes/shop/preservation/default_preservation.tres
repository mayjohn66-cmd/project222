[gd_resource type="Resource" script_class="PreservationSettings" load_steps=2 format=3]
[ext_resource type="Script" path="res://script/world/shop/preservation/preservation_settings.gd" id="1"]
[resource]
script = ExtResource("1")
units = Array[Dictionary]([
{"id":"fridge","name":"냉장함","capacity":12,"cost":120,"accepts":["spring_bud", "summer_mint", "bread", "camp_bread", "herbal_bread", "berry_filled_bread", "packed_mushroom_meal", "mushroom_stew", "traveler_stew", "berry_juice", "herb_drink", "dried_fruit"],"description":"새순과 물박하를 다음 계절까지 신선하게 보관합니다. 식품의 유통기한은 상온보다 두 배 천천히 줄어듭니다. 얼음은 냉동함이 필요합니다."},
{"id":"freezer","name":"냉동함","capacity":12,"cost":240,"accepts":["spring_bud", "summer_mint", "winter_frost", "bread", "camp_bread", "herbal_bread", "berry_filled_bread", "packed_mushroom_meal", "mushroom_stew", "traveler_stew", "dried_fruit"],"description":"서리 얼음과 식물 재료를 보존합니다. 냉동 가능한 식품의 유통기한 진행을 멈춥니다. 꺼낸 재료에는 상온 변형 규칙이 다시 적용됩니다."}
])
materials = Array[Dictionary]([
{"item":"spring_bud","season":"spring","result":"wilted_greens","description":"봄이 지난 뒤 맞는 아침에 시든 풀잎으로 변합니다. 냉장·냉동 보관하거나 베이킹 작업대에서 말려 두세요."},
{"item":"summer_mint","season":"summer","result":"wilted_greens","description":"여름이 지난 뒤 맞는 아침에 시든 풀잎으로 변합니다. 냉장·냉동 보관하거나 베이킹 작업대에서 말려 두세요."},
{"item":"winter_frost","season":"","result":"raw_water","description":"상온에서 다음 아침을 맞으면 채집한 물로 녹습니다. 냉동함에 넣어 두고 전달할 날 꺼내세요."}
])
