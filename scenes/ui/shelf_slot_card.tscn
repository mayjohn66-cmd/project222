[gd_scene format=3 uid="uid://vqgybj3dj1bs"]

[sub_resource type="GDScript" id="GDScript_c2ulq"]
script/source = "class_name ShelfSlotCard
extends Button


signal slot_selected(slot_index: int)


@onready var icon_rect: TextureRect = $IconRect
@onready var price_label: Label = $PriceLabel
@onready var stock_label: Label = $StockLabel


var slot_index: int = -1
var item_id: String = \"\"


func _ready():
	pressed.connect(
		_on_pressed
	)


func setup(
	new_slot_index: int,
	slot_data: Dictionary
):
	slot_index = new_slot_index

	item_id = str(
		slot_data.get(
			\"item_id\",
			\"\"
		)
	)

	var stock: int = int(
		slot_data.get(
			\"stock\",
			0
		)
	)

	var capacity: int = int(
		slot_data.get(
			\"capacity\",
			0
		)
	)

	if item_id.is_empty():
		icon_rect.texture = null
		price_label.text = \"빈 슬롯\"

	else:
		icon_rect.texture = (
			ItemData.get_item_icon(
				item_id
			)
		)

		var price: int = (
			ItemData.get_item_price(
				item_id
			)
		)

		price_label.text = (
			str(price)
			+ \"G\"
		)

	stock_label.text = (
		str(stock)
		+ \" / \"
		+ str(capacity)
	)


func _on_pressed():
	if slot_index < 0:
		return

	slot_selected.emit(
		slot_index
	)
"

